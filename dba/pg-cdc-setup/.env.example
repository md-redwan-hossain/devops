# Host Postgres (app + audit_logs + Sequin state DB)
# From Docker on Linux, use host.docker.internal (compose sets host-gateway).
DB_HOST=host.docker.internal
DB_PORT=5432
DB_NAME=myapp

# Sequin CDC role (must match sql/sequin_cdc.sql)
SEQUIN_USER=sequin_user
SEQUIN_USER_PASSWORD=change-me

# Sequin state database (created by sql/init_sequin_db.sql)
PG_HOSTNAME=host.docker.internal
PG_PORT=5432
PG_DATABASE=sequin
PG_USERNAME=postgres
PG_PASSWORD=change-me
PG_POOL_SIZE=10

# Sequin app secrets (generate your own for production)
SECRET_KEY_BASE=wDPLYus0pvD6qJhKJICO4dauYPXfO/Yl782Zjtpew5qRBDp7CZvbWtQmY0eB13If
VAULT_KEY=2Sig69bIpuSm2kv0VQfDekET2qy8qUZGI8v3/h3ASiY=

# Sequin YAML / console
SEQUIN_ADMIN_PASSWORD=admin
SEQUIN_API_TOKEN=replace-with-a-long-random-token

# Redis used by Sequin internally (not the audit sink)
REDIS_URL=redis://sequin_redis:6379

# Audit worker → same app DB
AUDIT_DB=Host=host.docker.internal;Port=5432;Database=myapp;Username=postgres;Password=change-me
SEQUIN_BASE_URL=http://sequin:7376
SEQUIN_CONSUMER_NAME=audit-stream
BATCH_SIZE=50
WAIT_FOR_MS=5000
POLL_IDLE_MS=1000
