[Unit]
Description=pgBackRest incremental backup (stanza main)
After=network.target postgresql@18-main.service
Requires=postgresql@18-main.service
Conflicts=pgbackrest-full.service

[Service]
Type=oneshot
User=postgres
ExecStart=/usr/bin/pgbackrest --stanza=main --repo=1 --type=incr backup
ExecStart=/usr/bin/pgbackrest --stanza=main --repo=2 --type=incr backup
