(html_cache_config) {
        @html {
                path *.html
        }
        header @html {
                Cache-Control "no-cache, no-store, must-revalidate"
                Pragma "no-cache"
                Expires "0"
        }
}

(websocket_config) {
        flush_interval -1
        transport http {
                read_timeout 300s
                write_timeout 300s
        }
}

(reverse_proxy_config) {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
}

https://demo.com {
        import html_cache_config
        encode zstd gzip

        @backend {
                path /api/*
                path /hubs/*
        }

        handle @backend {
                reverse_proxy app_backend:8080 {
                        import reverse_proxy_config
                        import websocket_config
                }
        }

        handle {
                reverse_proxy app_frontend:80 {
                        import reverse_proxy_config
                }
        }
}

https://s3.com {
        encode zstd gzip
        @console {
                path /
                path /rustfs/console*
        }
        handle @console {
                reverse_proxy rustfs_server:9001 {
                        import reverse_proxy_config
                }
        }
        handle {
                reverse_proxy rustfs_server:9000 {
                        import reverse_proxy_config
                        request_buffers 0
                        response_buffers 0
                        transport http {
                                read_timeout 300s
                                write_timeout 300s
                        }
                }
        }
}